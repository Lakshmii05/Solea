<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- SOLEA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="SOLEA"
            android:textColor="#F53C2D61"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <!-- Heading + Cart -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="Step into your style"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/cartButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_cart"
                android:contentDescription="Cart"
                android:background="@android:color/transparent"
                app:tint="#000000"
                android:padding="8dp"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Search -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Search shoes"
                android:padding="12dp"
                android:inputType="text"
                android:autofillHints="none"
                android:background="#EEEEEE" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:text="Search" />

        </LinearLayout>

        <!-- Categories -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Categories"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Men" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Women" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Running" />

        </LinearLayout>

        <!-- Popular Products -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Popular Products"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Products -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="horizontal"
            android:overScrollMode="always">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- PRODUCT 1 -->

                <LinearLayout
                    android:id="@+id/sportsShoeCard"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:padding="15dp"
                    android:orientation="vertical"
                    android:background="@android:color/transparent">

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/mens_sports_shoe"
                        android:scaleType="centerInside"
                        android:contentDescription="Men's Sports Shoe" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Men's Sports Shoe"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹1,499"
                        android:textSize="16sp"
                        android:textColor="#FF9800" />

                </LinearLayout>

                <!-- PRODUCT 2 -->

                <LinearLayout
                    android:id="@+id/casualShoeCard"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:padding="15dp"
                    android:orientation="vertical"
                    android:background="@android:color/transparent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:src="@drawable/mens_casual_shoe"
                        android:scaleType="centerInside"
                        android:contentDescription="Men's Casual Shoe" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Men's Casual Shoe"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹1,299"
                        android:textSize="16sp"
                        android:textColor="#FF9800" />

                </LinearLayout>

                <!-- PRODUCT 3 -->

                <LinearLayout
                    android:id="@+id/runningShoeCard"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:padding="15dp"
                    android:orientation="vertical"
                    android:background="@android:color/transparent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:src="@drawable/mens_running_shoe"
                        android:scaleType="centerInside"
                        android:contentDescription="Men's Running Shoe" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Men's Running Shoe"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹1,799"
                        android:textSize="16sp"
                        android:textColor="#FF9800" />

                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>


        <!-- vertical Women's Shoes -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- PRODUCT 1: Women's Sports Shoe -->

            <LinearLayout
                android:id="@+id/sportShoeCard"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:background="@android:color/transparent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/womens_sports_shoe"
                    android:scaleType="centerInside"
                    android:contentDescription="Women's Sports Shoe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Women's Sports Shoe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1,499"
                    android:textSize="16sp"
                    android:textColor="#FF9800" />

            </LinearLayout>

            <!-- PRODUCT 2: Women's Casual Shoe -->

            <LinearLayout
                android:id="@+id/casual_ShoeCard"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:background="@android:color/transparent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/womens_casuals"
                    android:scaleType="centerInside"
                    android:contentDescription="Women's Casual Shoe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Women's Casual Shoe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1,299"
                    android:textSize="16sp"
                    android:textColor="#FF9800" />

            </LinearLayout>

            <!-- PRODUCT 3: Women's Running Shoe -->

            <LinearLayout
                android:id="@+id/running_ShoeCard"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:padding="15dp"
                android:orientation="vertical"
                android:background="@android:color/transparent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:src="@drawable/womens_running"
                    android:scaleType="centerInside"
                    android:contentDescription="Women's Running Shoe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Women's Running Shoe"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1,799"
                    android:textSize="16sp"
                    android:textColor="#FF9800" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>